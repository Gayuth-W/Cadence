<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.cadence</groupId>
    <artifactId>cadence-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Cadence Progressive Delivery Platform</name>
    <description>Feature flags with automated canary analysis and metric-driven rollback</description>

    <modules>
        <module>cadence-core</module>
        <module>cadence-sdk</module>
        <module>cadence-service</module>
        <module>cadence-demo</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <jjwt.version>0.12.5</jjwt.version>
        <commons-math3.version>3.6.1</commons-math3.version>
        <resilience4j.version>2.2.0</resilience4j.version>
        <springdoc.version>2.5.0</springdoc.version>

        <!--
          Overrides the Flyway 9.22.3 that spring-boot-dependencies:3.2.5 manages.

          Flyway 10 split database-specific support out of flyway-core into per-database
          modules, so `flyway-database-postgresql` below exists only from 10.x onward. Boot 3.2's
          BOM does not know that artifact, which is why it needs an explicit version here.

          Worth the override: Flyway 10 is the first line that properly supports PostgreSQL 16,
          which is the image docker-compose runs.
        -->
        <flyway.version>10.10.0</flyway.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.cadence</groupId>
                <artifactId>cadence-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cadence</groupId>
                <artifactId>cadence-sdk</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-circuitbreaker</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-retry</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-micrometer</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>

            <!--
              flyway-core's version resolves from the ${flyway.version} property above, which Boot's
              BOM already parameterises. flyway-database-postgresql is not in that BOM at all, so it
              is managed here explicitly and kept in lockstep.
            -->
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-database-postgresql</artifactId>
                <version>${flyway.version}</version>
            </dependency>

            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>21</release>
                    <!--
                      REQUIRED. Without -parameters, Spring cannot infer @PathVariable /
                      @RequestParam names from the bytecode and every path-variable endpoint
                      fails at runtime on Spring Boot 3.2+. spring-boot-starter-parent sets
                      this already; it is pinned here so the build survives a parent change.
                    -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
